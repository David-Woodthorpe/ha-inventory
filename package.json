{
  "name": "inventory",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Self-hosted inventory for electronics parts, tools and supplies, with an AI-friendly REST API.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "seed": "node scripts/seed.mjs",
    "ingress-proxy": "node scripts/ingress-proxy.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
