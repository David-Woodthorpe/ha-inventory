# Where the SQLite database and uploads live (default: ./data)
# DATA_DIR=/var/lib/inventory

# Port for the production server (default: 3000)
# PORT=3000

# Optional. When set, every /api/v1 request must send
#   Authorization: Bearer <key>   (or X-Api-Key: <key>)
# Leave unset to keep the API open on your local network.
# INVENTORY_API_KEY=change-me

# Maximum upload size in megabytes (default: 50)
# MAX_UPLOAD_MB=50

# ISO 4217 code used as the default currency for new items (default: GBP)
# DEFAULT_CURRENCY=GBP

# Set to false to hide price, currency and inventory-value fields in the UI and
# API. Stored prices are kept and reappear if pricing is enabled again.
# ENABLE_PRICING=true

# Stable public URL used in /llms.txt and the API docs. Do not include /api/v1.
# Needed when the app is served through Home Assistant ingress or a reverse
# proxy at a fixed public address.
# PUBLIC_BASE_URL=https://inventory.example.com

# Optional. Force the public origin (scheme://host[:port]) used by SvelteKit.
# The production runtime derives this from X-Forwarded-Proto/Host automatically,
# so this is only needed for unusual reverse-proxy setups.
# ORIGIN=https://inventory.example.com

# Optional Home Assistant MQTT discovery. Leave MQTT_ENABLED unset and set
# MQTT_HOST to the broker's address; the app connects automatically. In the
# Home Assistant add-on the broker is discovered from the Supervisor instead.
# MQTT_ENABLED=true
# MQTT_HOST=192.168.1.10
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_SSL=false
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_TOPIC_PREFIX=inventory

# Optional Home Assistant calendar sync for service due dates. Create a local
# calendar in Home Assistant, then set its entity ID here. Every item with a
# next service due date gets one all-day event that moves forward when a
# service is logged. Requires HA_URL and a long-lived access token.
# HA_CALENDAR_ENTITY=calendar.inventory_service
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=eyJhbGciOi...
#
# In the Home Assistant add-on, set only the service_calendar_entity option;
# the Supervisor token and Core proxy are used automatically.
